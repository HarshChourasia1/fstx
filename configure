#!/bin/sh
# FST-X: writes src/Makevars from src/Makevars.in. Adds -ffp-contract=off when the C++ compiler accepts it:
# no fused multiply-add anywhere, so SIMD and plain code round the same and files are byte-identical on
# every CPU.
: "${R_HOME=`R RHOME`}"
if test -z "${R_HOME}"; then
  echo "could not determine R_HOME" >&2
  exit 1
fi
CXX=`"${R_HOME}/bin/R" CMD config CXX17`
CXXFLAGS=`"${R_HOME}/bin/R" CMD config CXX17FLAGS`
FLAGS=""
cat > conftest.cpp <<'EOT'
int main() { return 0; }
EOT
printf "checking whether %s accepts -ffp-contract=off... " "${CXX}"
if ${CXX} ${CXXFLAGS} -ffp-contract=off -c conftest.cpp -o conftest.o > /dev/null 2>&1; then
  FLAGS="-ffp-contract=off"
  echo "yes"
else
  echo "no"
fi
rm -f conftest.cpp conftest.o
sed "s|@FSTX_CXXFLAGS@|${FLAGS}|" src/Makevars.in > src/Makevars
exit 0
