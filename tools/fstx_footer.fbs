// FST-X footer schema, format version 3 ("fstx format 1.0"). Rules for later versions: fields are only ever
// added at the end of a table; the Page struct never
// changes (new per-page facts go into new lists in ColumnChunk, one entry per page).
// Compiled once with flatc (google/flatbuffers v25.12.19, Windows release binary):
//   flatc --cpp --scoped-enums -o ../src fstx_footer.fbs
// The generated header src/fstx_footer_generated.h is committed, so building the package never needs flatc.

namespace fstx.fb;

file_identifier "FSTX";

// How values sit in a page (the R storage type).
// Reserved: 4 = 64-bit integer (fstx 1.1; its page min/max are rounded outward to doubles), 5 = binary.
enum PhysType : ubyte { Int32 = 0, Float64 = 1, Logical = 2, String = 3 }

// R type layered on top of the physical type. Anything else is "None" and its
// attributes travel in Column.attrs. 4-255 reserved.
enum LogicalType : ubyte { None = 0, Factor = 1, Date = 2, POSIXct = 3 }

// Reserved: 3 = zstd with a dictionary, 4 = Pcodec, 5-127 later codecs, 128-255 experiments a release never
// writes (src/codec_ext.h).
enum Codec : ubyte { None = 0, LZ4 = 1, ZSTD = 2 }

// Speed profile the file was written with (informational).
enum Profile : ubyte { Fast = 0, Balanced = 1, Small = 2 }

// One page. Fixed size, so a vector of these is read without any copying.
struct Page {
  offset: ulong;      // absolute file offset of the stored bytes (64-byte aligned)
  first_row: ulong;   // first row of the page, counted from the start of the file
  hash: ulong;        // XXH3-64 of the stored (compressed) bytes
  min: double;        // statistics over non-missing values (numeric types only)
  max: double;
  comp_len: uint;     // stored length in the file
  raw_len: uint;      // length of the encoded page body after the codec is removed
  row_count: uint;    // rows (dictionary pages: number of dictionary entries)
  null_count: uint;   // NA count (NA_real_ only for doubles, NaN is a value)
  chain: uint;        // encoding chain, one byte each: [page kind | NA mode << 4], top encoding,
                      // first child encoding, second child encoding (see src/enc.h). The page body
                      // repeats it and the reader checks that both agree.
  codec: Codec;
  flags: ubyte;       // bit 0: min/max are valid
}

table ColumnChunk {
  pages: [Page];
  dictionary: Page;         // string dictionary page shared by this chunk's pages (absent if none)
}

table RowGroup {
  first_row: ulong;
  row_count: ulong;
  columns: [ColumnChunk];   // one per column, in schema order
}

table Column {
  name: string;             // UTF-8
  phys: PhysType;
  logical: LogicalType;
  ordered: bool;            // ordered factor
  levels: [string];         // factor levels, UTF-8, once per column
  tzone: string;            // POSIXct time zone; absent when the column has no tzone attribute
  attrs: [ubyte];           // other R attributes: serialize(list(...)) from R, empty if none (readers that are
                            // not R may ignore it)
}

table Footer {
  format_version: ushort;
  row_count: ulong;
  row_group_size: ulong;
  columns: [Column];
  row_groups: [RowGroup];
  table_attrs: [ubyte];     // data.frame-level attributes (class etc.), R-serialized
  created_by: string;
  profile: Profile = Balanced;
  // format 3
  required_features: ulong;  // feature bits a reader must know (bits 0-15 repeat header bytes 6-7)
  optional_features: ulong;  // feature bits a reader may ignore
  feature_names: [string];   // a name for each set bit: required bits, then optional bits, each in ascending order
}

root_type Footer;
